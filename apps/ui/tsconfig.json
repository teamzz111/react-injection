{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "declaration": true,
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src",
    "stories/Modal.stories.tsx",
    "stories/Card.stories.tsx",
    "stories/Badge.stories.tsx",
    "stories/Button.stories.tsx"
  ]
}
